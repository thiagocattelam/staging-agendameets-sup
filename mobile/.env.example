# URL do backend Next.js (o mesmo agendameets-sup).
# Celular físico (mesma rede Wi-Fi): use o IP de rede local da máquina, ex. "http://192.168.0.10:3000"
# Emulador Android: use sempre "http://10.0.2.2:3000" (alias especial que aponta pro localhost do host,
# evita problema de NAT do emulador ao tentar alcançar o IP da própria máquina)
EXPO_PUBLIC_API_URL="http://192.168.0.10:3000"

# Mesmo valor do AUTH_GOOGLE_ID do backend (client "Web application").
# É usado como webClientId no GoogleSignin.configure() para o idToken sair com a audiência certa.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="mesmo-valor-do-AUTH_GOOGLE_ID"
