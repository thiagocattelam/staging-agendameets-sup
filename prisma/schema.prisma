generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Atendente{
  id String @id @default(cuid())
  nome String
  ativo Boolean @default(true)
  email String? @unique
  alertaMinutos Int? @default(30)
  createdAt DateTime @default(now())
  agendamentos Agendamento[]

  googleCalendarConectado Boolean @default(false)
  googleCredencial GoogleCredencial?
}
model GoogleCredencial{
  id String @id @default(cuid())
  accessToken String?
  refreshToken String?
  tokenExpiry DateTime?

  atendente Atendente @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  atendenteId String @unique
}

model Agendamento{
  id String @id @default(cuid())
  dataHoraInicio DateTime
  dataHoraFim DateTime
  cliente String
  linkUmbler String?
  observacoes String?
  alertaMinutos Int?
  googleEventId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atendente Atendente @relation(fields: [atendenteId], references: [id])
  atendenteId String

  assuntos Assunto[]

  status Status @relation(fields: [statusId], references: [id])
  statusId String
}
model Assunto{
  id String @id @default(cuid())
  descricao String
  agendamentos Agendamento[]
}

model Status{
  id String @id @default(cuid())
  descricao String
  corHex String
  agendamentos Agendamento[]
}

